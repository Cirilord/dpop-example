# --- Keycloak (also used by docker-compose defaults) ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=dpop-demo
KEYCLOAK_CLIENT_ID=dpop-client
KEYCLOAK_USERNAME=alice
KEYCLOAK_PASSWORD=alice
KEYCLOAK_ISSUER=http://localhost:8080/realms/dpop-demo
KEYCLOAK_AUDIENCE=dpop-api
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/dpop-demo/protocol/openid-connect/certs

# --- Resource Server ---
SERVER_PORT=3000
RESOURCE_SERVER_PUBLIC_URL=http://localhost:3000

# DPoP proofs older/newer than this window are rejected.
DPOP_IAT_TOLERANCE_SECONDS=60

# Redis TTL for jti keys. Must cover the whole IAT window (±tolerance),
# so a proof accepted at the edge of the window cannot be replayed later.
DPOP_JTI_TTL_SECONDS=120

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# Print every DPoP validation step to stdout.
DPOP_VERBOSE=true
